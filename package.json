{
  "name": "flickleaf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Firefox reader where your hand controls the pace.",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.js",
    "dev": "node build.mjs --serve",
    "test:browser": "node tests/browser.mjs",
    "lint:extension": "web-ext lint --source-dir dist",
    "package": "npm run build && web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "web-ext": "^10.7.0"
  }
}
