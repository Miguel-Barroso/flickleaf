{
  "manifest_version": 3,
  "name": "Flickleaf",
  "version": "0.3.0",
  "description": "Put the words in one place. Let your hand control the pace.",
  "permissions": [
    "activeTab",
    "scripting",
    "menus"
  ],
  "action": {
    "default_title": "Read with Flickleaf",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rsvp-reader@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
