{
  "manifest_version": 3,
  "name": "Flickleaf",
  "version": "0.8.0",
  "description": "Put the words in one place. Let your hand control the pace.",
  "permissions": [
    "activeTab",
    "scripting",
    "menus",
    "storage"
  ],
  "action": {
    "default_title": "Read with Flickleaf",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rsvp-reader@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
